{
  "name": "ministere-docteur-silas",
  "version": "2.0.0",
  "private": true,
  "description": "Plateforme du Ministère d'Enseignement du Docteur B. Silas Gbavou",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "next build",
    "predev": "node scripts/copy-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "admin:hash": "tsx --conditions=react-server scripts/admin-hash.ts",
    "models:check": "tsx --conditions=react-server scripts/models-check.ts",
    "edition:import": "tsx --conditions=react-server scripts/import-edition.ts",
    "icons": "tsx --conditions=react-server scripts/generate-icons.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "better-sqlite3": "13.0.3",
    "next": "16.4.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
