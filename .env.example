# ─────────────────────────────────────────────────────────────
#  Plateforme Dr B. Silas Gbavou — variables d'environnement
#  Copier ce fichier vers .env puis compléter les valeurs.
# ─────────────────────────────────────────────────────────────

# Base de données (SQLite en développement).
# En production : basculer le provider vers postgresql dans prisma/schema.prisma
# puis utiliser une URL du type postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions (JWT). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="changez-moi-par-une-valeur-aleatoire-de-48-octets"

# URL publique du site (liens de partage, métadonnées, e-mails).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Intelligence artificielle (obligatoire pour l'IA pédagogique) ──
# Clé API Anthropic : https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Modèle utilisé pour la génération des réponses et la classification.
ANTHROPIC_MODEL="claude-opus-5"

# ── Embeddings (recherche sémantique du RAG) ──
# Optionnel : si VOYAGE_API_KEY est absent, un moteur d'embeddings local
# déterministe prend le relais (suffisant pour le développement et les petits corpus).
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3.5"

# ── YouTube ──
# Clé API YouTube Data v3 (import automatique des vidéos de la chaîne).
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# ── Transcription audio (optionnelle, format .opus WhatsApp) ──
# Point d'accès HTTP compatible multipart (champ "file") renvoyant { "text": "..." }.
TRANSCRIPTION_ENDPOINT=""
TRANSCRIPTION_API_KEY=""
TRANSCRIPTION_MODEL=""

# ── Stockage des fichiers ──
# Répertoire hors web-root pour les PDF protégés et les audios.
STORAGE_DIR="./storage"

# ── Compte administrateur créé au seed ──
ADMIN_EMAIL="Silasgbavou@gmail.com"
ADMIN_PASSWORD="ChangezCeMotDePasse2024!"
ADMIN_NAME="Docteur B. Silas Gbavou"

# ── Contacts publics ──
NEXT_PUBLIC_WHATSAPP="+22901679600 94"
NEXT_PUBLIC_PHONE="+2290167960094"
NEXT_PUBLIC_EMAIL="Silasgbavou@gmail.com"
