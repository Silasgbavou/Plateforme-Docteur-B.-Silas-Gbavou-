# Copier en .env.local (dev) ou définir dans le gestionnaire de secrets de l'hébergeur.
# Aucune valeur réelle ne doit être commitée.

# URL publique canonique (utilisée pour canonical, sitemap, Origin check)
SITE_URL=http://localhost:3000
# Audience : "private" => noindex global ; "public" => indexation des seules pages publiques
SITE_AUDIENCE=private

# Base SQLite (fichier) et stockage des éditions (PDF originaux, hors /public)
DATABASE_PATH=./data/ministere.sqlite
STORAGE_DIR=./storage

# Secret de signature des cookies de session (>= 32 caractères aléatoires) : openssl rand -base64 48
SESSION_SECRET=

# Administration /gestion : email + empreinte scrypt générée par `pnpm admin:hash`
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Fournisseur de génération : "gemini" | "openai" | "none" (mode documentaire seul)
LLM_PROVIDER=none
GEMINI_API_KEY=
# Liste ordonnée de modèles AUTORISÉS, vérifiés avec `pnpm models:check` (aucune valeur par défaut devinée)
GEMINI_MODELS=
OPENAI_API_KEY=
OPENAI_MODELS=
# Repli inter-fournisseur uniquement si approuvé (coût) : "true" | "false"
LLM_CROSS_PROVIDER_FALLBACK=false
# Délai maximum d'une génération (ms) et plafond global de requêtes/minute (tous utilisateurs)
LLM_TIMEOUT_MS=45000
LLM_GLOBAL_RPM=30

# Embeddings (facultatif) : modèle et dimension versionnés ; vide => recherche lexicale seule
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768

# Points d'accès officiels (modifiables uniquement pour un proxy d'entreprise ou des tests)
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_BASE=https://api.openai.com/v1

# Synchronisation Google Drive (lecture seule) : JSON du compte de service (contenu, base64 ou chemin .json).
# Le propriétaire partage le dossier autorisé avec l'adresse du compte de service, en lecteur.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_FOLDER_ID=1eVNAgUtMHp8Op2qvXdseVWWVFIt0ggxI
